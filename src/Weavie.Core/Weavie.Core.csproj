<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LibraryImport (source-generated P/Invoke for the macOS PTY) requires unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- TOML store for user settings (comment-preserving DocumentSyntax round-trip). -->
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="WeCantSpell.Hunspell" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Weavie.Core.Tests" />
    <EmbeddedResource Include="Spelling/Resources/*" />
    <Content Include="../../third-party/spelling/*" Link="third-party/spelling/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
