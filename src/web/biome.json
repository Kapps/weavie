{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../.."
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "plugins": [
    {
      "path": "./lint/typography.grit",
      "includes": ["**/src/**/*.css", "!**/fonts.css", "!**/*.prose.css"]
    },
    {
      "path": "./lint/font-tokens.grit",
      "includes": ["**/src/**/*.css", "!**/src/styles.css"]
    },
    {
      "path": "./lint/icon-size.grit",
      "includes": ["**/src/**/*.tsx"]
    },
    {
      "path": "./lint/selected-session.grit",
      "includes": [
        "**/src/**/*.ts",
        "**/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/src/bridge.ts",
        "!**/src/App.tsx",
        "!**/src/commands/registry.ts",
        "!**/src/files/open-path.ts"
      ]
    },
    {
      "path": "./lint/selection-listener.grit",
      "includes": [
        "**/src/**/*.ts",
        "**/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/src/bridge.ts",
        "!**/src/commands/registry.ts",
        "!**/src/chrome/session-store.ts",
        "!**/src/editor/editor-controller.ts"
      ]
    },
    {
      "path": "./lint/active-backend.grit",
      "includes": [
        "**/src/**/*.ts",
        "**/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/src/bridge.ts",
        "!**/src/App.tsx",
        "!**/src/commands/registry.ts"
      ]
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "globals": ["weavie", "MonacoEnvironment"]
  },
  "overrides": [
    {
      "includes": ["**/e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/chrome/ResizeFrame.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/editor/diff.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/chrome/ControlMenu.tsx",
        "**/src/agent/AgentSlashMenu.tsx",
        "**/src/chrome/Omnibar.tsx",
        "**/src/chrome/BranchTypeahead.tsx",
        "**/src/chrome/DiffAgainstPrompt.tsx",
        "**/src/chrome/DeleteSessionDialog.tsx",
        "**/src/chrome/OpenPrPrompt.tsx",
        "**/src/chrome/CredentialPrompt.tsx",
        "**/src/chrome/RegisterAgentModal.tsx",
        "**/src/chrome/UrlPrompt.tsx",
        "**/src/chrome/SearchPanel.tsx",
        "**/src/files/FileBrowser.tsx",
        "**/src/editor/ConfirmDialog.tsx",
        "**/src/editor/preview/EmbedLightbox.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    }
  ]
}
