language css

CssGenericProperty(name=$p, value=$v) as $d where {
  or {
    and {
      $p <: r"(?i)^font-size$",
      not $v <: r"^(?:inherit|var\(--font-(?:chrome-hero|chrome-display|chrome-lead|chrome|chrome-badge|content|content-secondary|content-title|prose)-size\))$"
    },
    and {
      $p <: r"(?i)^font-weight$",
      not $v <: r"^(?:inherit|var\(--font-(?:weight-regular|weight-emphasis|weight-mono-bold|content-weight|prose-weight)\))$"
    },
    and {
      $p <: r"(?i)^line-height$",
      not $v <: r"^(?:inherit|var\(--font-(?:chrome-line|chrome-line-wrap|chrome-display-line|chrome-hero-line|content-line|content-row-line|prose-line)\))$"
    },
    and {
      $p <: r"(?i)^font$",
      not $v <: r"^(?:inherit|var\(--font-(?:chrome-hero|chrome-display|chrome-lead|chrome-body|chrome-body-wrap|chrome-badge|chrome-mono|content|prose)\))$"
    }
  },
  register_diagnostic(span=$d, message="Typography must use a --font-* role token (docs/concepts/design-system.md)", severity="error")
}
