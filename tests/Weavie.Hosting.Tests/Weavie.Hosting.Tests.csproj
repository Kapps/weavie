<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test method names are the documentation; require the XML-doc analyzers elsewhere, not here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Weavie.Hosting\Weavie.Hosting.csproj" />
    <ProjectReference Include="..\..\tools\Weavie.FakeAcp\Weavie.FakeAcp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Weavie.McpProxy\Weavie.McpProxy.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyMcpProxyForTests" AfterTargets="Build">
    <PropertyGroup>
      <_McpProxyExe Condition="$([MSBuild]::IsOSPlatform('Windows'))">weavie-mcp-proxy.exe</_McpProxyExe>
      <_McpProxyExe Condition="'$(_McpProxyExe)' == ''">weavie-mcp-proxy</_McpProxyExe>
      <_McpProxyDir>$(MSBuildProjectDirectory)\..\..\src\Weavie.McpProxy\bin\$(Configuration)\net10.0\</_McpProxyDir>
    </PropertyGroup>
    <ItemGroup>
      <_McpProxyOutput Include="$(_McpProxyDir)$(_McpProxyExe)" />
      <_McpProxyOutput Include="$(_McpProxyDir)weavie-mcp-proxy.dll" />
      <_McpProxyOutput Include="$(_McpProxyDir)weavie-mcp-proxy.deps.json" />
      <_McpProxyOutput Include="$(_McpProxyDir)weavie-mcp-proxy.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_McpProxyOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
